# Non-secret configuration for the Cloud Functions. Committed on purpose.
# The two real secrets (STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET) are NOT
# here — they live in Secret Manager, written by the GitHub Action from the
# repository's secrets. See STRIPE_SETUP.md.

# Where the website lives. Checkout returns here after paying or backing out.
SITE_URL=https://improvy.app/

# Let Stripe work out VAT per buyer. Needs Stripe Tax switched on in the
# Stripe dashboard first, or every checkout fails to open. See STRIPE_SETUP.md.
STRIPE_AUTOMATIC_TAX=false

# Optional. Leave empty and the checkout describes Improvy Pro itself — name,
# description, 18,99 € and the app's icon — with nothing to create in the
# Stripe dashboard. Put a price_… here to let the Stripe catalogue rule
# instead; then the name and the image come from the product there.
STRIPE_PRICE_ID=

# Optional. The square image on the Stripe checkout page. Empty means the app
# icon served next to the site: <SITE_URL>improvy-pro.png. Must be public.
PRO_IMAGE_URL=
