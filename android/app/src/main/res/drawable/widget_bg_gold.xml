<?xml version="1.0" encoding="utf-8"?>
<!-- Same surface, but framed in gold — used while today's challenge is still
     unplayed, so the widget reads as "your move" at a glance. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient
                android:angle="270"
                android:startColor="#2A1E38"
                android:endColor="#161020"
                android:type="linear" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <stroke android:width="1dp" android:color="#8CFBBF24" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</layer-list>
