<?xml version="1.0" encoding="utf-8"?>
<!-- The app's card surface, as a widget background: the same top-lit
     #221830 → #141020 gradient used by the Daily Challenge card, under a
     hairline at 12% white. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient
                android:angle="270"
                android:startColor="#221830"
                android:endColor="#141020"
                android:type="linear" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <stroke android:width="1dp" android:color="#1FFFFFFF" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</layer-list>
