<?xml version="1.0" encoding="utf-8"?>
<!-- "Your move": the same surface with the glow and the edge turned up. Used
     while today's challenge is unplayed, and on a streak about to break —
     nothing else earns it. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/widget_radius" />
            <gradient
                android:angle="315"
                android:startColor="#241A32"
                android:endColor="#0E0A18"
                android:type="linear" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/widget_radius" />
            <gradient
                android:type="radial"
                android:centerX="0.08"
                android:centerY="0.06"
                android:gradientRadius="200dp"
                android:startColor="#5CFCD34D"
                android:endColor="#00000000" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/widget_radius" />
            <stroke android:width="1dp" android:color="#8CFCD34D" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</layer-list>
