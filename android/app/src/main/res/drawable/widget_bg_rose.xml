<?xml version="1.0" encoding="utf-8"?>
<!-- The widget surface: the app's #1B1428 → #0E0A18 ink under a rose
     glow from the top-left corner. No border: the launcher already frames
     a widget, and a second outline drawn inside that frame reads as a lit
     rectangle sitting in the middle of the home screen. The glow is what
     keeps a screen full of dark rectangles from reading as one block. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/widget_radius" />
            <gradient
                android:angle="315"
                android:startColor="#1B1428"
                android:endColor="#0E0A18"
                android:type="linear" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/widget_radius" />
            <gradient
                android:type="radial"
                android:centerX="0.08"
                android:centerY="0.06"
                android:gradientRadius="190dp"
                android:startColor="#2EF43F5E"
                android:endColor="#00000000" />
        </shape>
    </item>
</layer-list>
