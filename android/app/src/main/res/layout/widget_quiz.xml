<?xml version="1.0" encoding="utf-8"?>
<!-- Design 8 (Question 2x2). RemoteViews only inflates the classes tagged
     @RemoteView — no Space, no View, no ConstraintLayout, no custom drawing.
     Weighted FrameLayouts are the spacers. Colours that vary per key or per
     mode arrive as a tint applied to widget_tile_white / widget_square_white,
     because a background drawable cannot be recoloured from RemoteViews. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/quiz_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="14dp">

    <TextView
        android:id="@+id/quiz_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_quiz_label"
        android:textColor="#FCD34D"
        android:textSize="9sp"
        android:letterSpacing="0.18"
        android:maxLines="1"
        android:fontFamily="@font/lexend_semibold" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/quiz_degree"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/widget_quiz_degree_placeholder"
        android:textColor="#FFFF4D"
        android:textSize="38sp"
        android:maxLines="1"
        android:fontFamily="@font/outfit_semibold" />

    <TextView
        android:id="@+id/quiz_of"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="4dp"
        android:text="@string/widget_quiz_of_placeholder"
        android:textColor="#8CFFFFFF"
        android:textSize="13sp"
        android:maxLines="1"
        android:fontFamily="@font/lexend_medium" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/quiz_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/widget_quiz_hint"
        android:textColor="#73FFFFFF"
        android:textSize="10sp"
        android:maxLines="1"
        android:fontFamily="@font/lexend_medium" />
</LinearLayout>
