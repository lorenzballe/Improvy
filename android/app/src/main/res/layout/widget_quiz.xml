<?xml version="1.0" encoding="utf-8"?>
<!-- ① Question 2×2 — the same card as the iOS small question widget.
     RemoteViews inflates only @RemoteView classes: no Space, no plain View,
     no ConstraintLayout. Weighted FrameLayouts are the spacers. Every colour
     that changes at runtime is a setColorFilter on a white drawable, set from
     ImprovyWidgets.kt; the colours written here are the picker preview. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/quiz_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/w_surface"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/quiz_glow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/w_glow"
        android:importantForAccessibility="no"
        android:tint="#2BFCD34D"
        android:tintMode="src_in"
        android:scaleType="fitXY" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clipChildren="false"
            android:clipToPadding="false">

            <ImageView
                android:id="@+id/quiz_eb_icon"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/w_ic_question"
                android:importantForAccessibility="no"
                android:tint="#FCD34D" />

            <TextView
                android:id="@+id/quiz_eb_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/widget_quiz_short_label"
                android:textColor="#FCD34D"
                android:textSize="11.1sp"
                android:fontFamily="@font/outfit_semibold"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                android:letterSpacing="0.1"
                android:ellipsize="end" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="4dp"
            android:clipChildren="false"
            android:clipToPadding="false" />

        <TextView
            android:id="@+id/quiz_degree"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="♭3"
            android:textColor="#FCD34D"
            android:textSize="53.0sp"
            android:fontFamily="@font/outfit_semibold"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:gravity="center_vertical"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="22sp"
            android:autoSizeMaxTextSize="53.0sp"
            android:autoSizeStepGranularity="1sp" />

        <TextView
            android:id="@+id/quiz_of"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="of E♭"
            android:textColor="#B8FFFFFF"
            android:textSize="15.9sp"
            android:fontFamily="@font/outfit_medium"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:ellipsize="end"
            android:layout_marginTop="2dp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="4dp"
            android:clipChildren="false"
            android:clipToPadding="false" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clipChildren="false"
            android:clipToPadding="false">

            <ImageView
                android:layout_width="11dp"
                android:layout_height="11dp"
                android:src="@drawable/w_ic_eye"
                android:importantForAccessibility="no"
                android:tint="#7AFFFFFF"
                android:tintMode="src_in" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_quiz_hint"
                android:textColor="#7AFFFFFF"
                android:textSize="11.7sp"
                android:fontFamily="@font/outfit_medium"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:layout_marginStart="4dp"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
