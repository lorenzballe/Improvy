<?xml version="1.0" encoding="utf-8"?>
<!-- ⑥ Weakest key 2×2 — the iOS small needs-work widget.
     RemoteViews inflates only @RemoteView classes: no Space, no plain View,
     no ConstraintLayout. Weighted FrameLayouts are the spacers. Every colour
     that changes at runtime is a setColorFilter on a white drawable, set from
     ImprovyWidgets.kt; the colours written here are the picker preview. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/weak_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/w_surface"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/weak_glow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/w_glow"
        android:importantForAccessibility="no"
        android:tint="#2BFB7185"
        android:scaleType="fitXY" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/weak_eb_icon"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/w_ic_target"
                android:importantForAccessibility="no"
                android:tint="#FB7185" />

            <TextView
                android:id="@+id/weak_eb_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/widget_weak_label"
                android:textColor="#FB7185"
                android:textSize="10.5sp"
                android:fontFamily="@font/lexend_semibold"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                android:letterSpacing="0.06"
                android:ellipsize="end" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <FrameLayout
                android:layout_width="50dp"
                android:layout_height="50dp">

                <ImageView
                    android:id="@+id/weak_badge"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/w_badge"
                    android:importantForAccessibility="no"
                    android:tint="#FCD34D" />

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/w_badge_sheen"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/weak_badge_text"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="?"
                    android:textColor="#140F1C"
                    android:textSize="21sp"
                    android:fontFamily="@font/lexend_bold"
                    android:maxLines="1"
                    android:includeFontPadding="false"
                    android:gravity="center"
                    android:paddingStart="3dp"
                    android:paddingEnd="3dp"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="10sp"
                    android:autoSizeMaxTextSize="21sp"
                    android:autoSizeStepGranularity="1sp" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="11dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="bottom">

                    <TextView
                        android:id="@+id/weak_pct"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textColor="#FFFFFF"
                        android:textSize="28sp"
                        android:fontFamily="@font/lexend_bold"
                        android:maxLines="1"
                        android:includeFontPadding="false" />

                    <TextView
                        android:id="@+id/weak_pct_sign"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="%"
                        android:textColor="#8CFFFFFF"
                        android:textSize="14sp"
                        android:fontFamily="@font/lexend_semibold"
                        android:maxLines="1"
                        android:includeFontPadding="false"
                        android:layout_marginStart="1dp"
                        android:paddingBottom="3dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/weak_sub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_weak_mastered"
                    android:textColor="#7AFFFFFF"
                    android:textSize="10.5sp"
                    android:fontFamily="@font/lexend_medium"
                    android:maxLines="1"
                    android:includeFontPadding="false"
                    android:ellipsize="end"
                    android:layout_marginTop="1dp" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="6dp" />

        <TextView
            android:id="@+id/weak_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/widget_weak_hint"
            android:textColor="#99FFFFFF"
            android:textSize="10.5sp"
            android:fontFamily="@font/lexend_medium"
            android:maxLines="2"
            android:includeFontPadding="false"
            android:ellipsize="end" />
    </LinearLayout>
</FrameLayout>
