<?xml version="1.0" encoding="utf-8"?>
<!-- ③ Level 2×2 — the iOS small level widget, with the app's own animal.
     RemoteViews inflates only @RemoteView classes: no Space, no plain View,
     no ConstraintLayout. Weighted FrameLayouts are the spacers. Every colour
     that changes at runtime is a setColorFilter on a white drawable, set from
     ImprovyWidgets.kt; the colours written here are the picker preview. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/level_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/w_surface"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/level_glow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/w_glow"
        android:importantForAccessibility="no"
        android:tint="#2B34D399"
        android:scaleType="fitXY" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/level_eb_icon"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/w_ic_sparkles"
                android:importantForAccessibility="no"
                android:tint="#34D399" />

            <TextView
                android:id="@+id/level_eb_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/widget_level_label"
                android:textColor="#34D399"
                android:textSize="10.5sp"
                android:fontFamily="@font/lexend_semibold"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                android:letterSpacing="0.06"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/level_rank"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1/8"
                android:textColor="#7AFFFFFF"
                android:textSize="10.5sp"
                android:fontFamily="@font/lexend_semibold"
                android:maxLines="1"
                android:includeFontPadding="false" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <FrameLayout
                android:layout_width="38dp"
                android:layout_height="38dp">

                <ImageView
                    android:id="@+id/level_circle"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/w_circle"
                    android:importantForAccessibility="no"
                    android:tint="#2E34D399" />

                <ImageView
                    android:id="@+id/level_animal"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_animal_snail"
                    android:importantForAccessibility="no"
                    android:tint="#34D399"
                    android:layout_gravity="center" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="9dp">

                <TextView
                    android:id="@+id/level_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_level_name_placeholder"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:fontFamily="@font/lexend_bold"
                    android:maxLines="1"
                    android:includeFontPadding="false"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/level_quote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_level_quote_placeholder"
                    android:textColor="#7AFFFFFF"
                    android:textSize="10sp"
                    android:fontFamily="@font/lexend_medium"
                    android:maxLines="1"
                    android:includeFontPadding="false"
                    android:ellipsize="end"
                    android:layout_marginTop="1dp" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="4dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="bottom">

            <TextView
                android:id="@+id/level_pct"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#FFFFFF"
                android:textSize="34sp"
                android:fontFamily="@font/lexend_bold"
                android:maxLines="1"
                android:includeFontPadding="false" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="%"
                android:textColor="#8CFFFFFF"
                android:textSize="17sp"
                android:fontFamily="@font/lexend_semibold"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:layout_marginStart="2dp"
                android:paddingBottom="3dp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp">

            <ProgressBar
                android:id="@+id/level_bar"
                android:layout_width="match_parent"
                android:layout_height="5dp"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:progressDrawable="@drawable/w_bar"
                android:indeterminate="false"
                android:max="100"
                android:progress="0"
                android:minHeight="5dp"
                android:maxHeight="5dp" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
