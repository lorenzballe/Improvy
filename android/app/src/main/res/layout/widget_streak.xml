<?xml version="1.0" encoding="utf-8"?>
<!-- ⑤ Streak 2×2 — the iOS small streak widget.
     RemoteViews inflates only @RemoteView classes: no Space, no plain View,
     no ConstraintLayout. Weighted FrameLayouts are the spacers. Every colour
     that changes at runtime is a setColorFilter on a white drawable, set from
     ImprovyWidgets.kt; the colours written here are the picker preview. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/streak_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/w_surface"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/streak_glow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/w_glow"
        android:importantForAccessibility="no"
        android:tint="#2BF97316"
        android:tintMode="src_in"
        android:scaleType="fitXY" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clipChildren="false"
            android:clipToPadding="false">

            <ImageView
                android:id="@+id/streak_eb_icon"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/w_ic_flame"
                android:importantForAccessibility="no"
                android:tint="#F97316" />

            <TextView
                android:id="@+id/streak_eb_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/widget_streak_label"
                android:textColor="#F97316"
                android:textSize="11.1sp"
                android:fontFamily="@font/outfit_semibold"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                android:letterSpacing="0.1"
                android:ellipsize="end" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="4dp"
            android:clipChildren="false"
            android:clipToPadding="false" />

        <TextView
            android:id="@+id/streak_count"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="0"
            android:textColor="#FFFFFF"
            android:textSize="53.0sp"
            android:fontFamily="@font/outfit_semibold"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:gravity="center_vertical"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="24sp"
            android:autoSizeMaxTextSize="53.0sp"
            android:autoSizeStepGranularity="1sp" />

        <TextView
            android:id="@+id/streak_caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/widget_streak_caption"
            android:textColor="#7AFFFFFF"
            android:textSize="11.7sp"
            android:fontFamily="@font/outfit_semibold"
            android:maxLines="2"
            android:includeFontPadding="false"
            android:ellipsize="end"
            android:layout_marginTop="2dp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="6dp"
            android:clipChildren="false"
            android:clipToPadding="false" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:clipChildren="false"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:clipChildren="false"
                android:clipToPadding="false">

                <ImageView
                    android:id="@+id/streak_d0"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:src="@drawable/w_dot"
                    android:importantForAccessibility="no"
                    android:tint="#1AFFFFFF"
                    android:tintMode="src_in" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_marginStart="6dp"
                android:clipChildren="false"
                android:clipToPadding="false">

                <ImageView
                    android:id="@+id/streak_d1"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:src="@drawable/w_dot"
                    android:importantForAccessibility="no"
                    android:tint="#1AFFFFFF"
                    android:tintMode="src_in" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_marginStart="6dp"
                android:clipChildren="false"
                android:clipToPadding="false">

                <ImageView
                    android:id="@+id/streak_d2"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:src="@drawable/w_dot"
                    android:importantForAccessibility="no"
                    android:tint="#1AFFFFFF"
                    android:tintMode="src_in" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_marginStart="6dp"
                android:clipChildren="false"
                android:clipToPadding="false">

                <ImageView
                    android:id="@+id/streak_d3"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:src="@drawable/w_dot"
                    android:importantForAccessibility="no"
                    android:tint="#1AFFFFFF"
                    android:tintMode="src_in" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_marginStart="6dp"
                android:clipChildren="false"
                android:clipToPadding="false">

                <ImageView
                    android:id="@+id/streak_d4"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:src="@drawable/w_dot"
                    android:importantForAccessibility="no"
                    android:tint="#1AFFFFFF"
                    android:tintMode="src_in" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_marginStart="6dp"
                android:clipChildren="false"
                android:clipToPadding="false">

                <ImageView
                    android:id="@+id/streak_d5"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:src="@drawable/w_dot"
                    android:importantForAccessibility="no"
                    android:tint="#1AFFFFFF"
                    android:tintMode="src_in" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_marginStart="6dp"
                android:clipChildren="false"
                android:clipToPadding="false">

                <ImageView
                    android:id="@+id/streak_d6"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:src="@drawable/w_dot"
                    android:importantForAccessibility="no"
                    android:tint="#1AFFFFFF"
                    android:tintMode="src_in" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
