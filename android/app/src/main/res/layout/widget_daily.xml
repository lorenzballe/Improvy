<?xml version="1.0" encoding="utf-8"?>
<!-- Today's challenge at a glance: the key to play in, or the score once it's
     done, with the streak always in sight — the streak is the thing that
     brings people back.

     The weighted FrameLayouts below are spacers, and they are FrameLayouts
     rather than the obvious <Space> on purpose: RemoteViews inflates only the
     handful of classes tagged @RemoteView, and Space is not among them. It
     compiles, it previews fine in Android Studio, and then on the device it
     throws "Class not allowed to be inflated" — which kills the whole widget,
     not just the spacer. Same rule applies to any view added here later. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/daily_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg_gold"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/daily_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/widget_daily_label"
            android:textColor="#FCD34D"
            android:textSize="9sp"
            android:letterSpacing="0.18"
            android:maxLines="1"
            android:ellipsize="end"
            android:fontFamily="@font/lexend_black" />

        <TextView
            android:id="@+id/daily_streak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_chip_gold"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="@string/widget_daily_streak_placeholder"
            android:textColor="#FCD34D"
            android:textSize="10sp"
            android:maxLines="1"
            android:fontFamily="@font/lexend_black" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/daily_headline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_daily_placeholder"
        android:textColor="#FFFFFFFF"
        android:textSize="22sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:fontFamily="@font/lexend_black" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/daily_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_daily_sub_placeholder"
        android:textColor="#8CFFFFFF"
        android:textSize="11sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:fontFamily="@font/lexend_semibold" />
</LinearLayout>
