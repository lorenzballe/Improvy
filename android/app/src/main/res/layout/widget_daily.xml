<?xml version="1.0" encoding="utf-8"?>
<!-- ② Daily Challenge 4×2 — the iOS medium daily widget.
     RemoteViews inflates only @RemoteView classes: no Space, no plain View,
     no ConstraintLayout. Weighted FrameLayouts are the spacers. Every colour
     that changes at runtime is a setColorFilter on a white drawable, set from
     ImprovyWidgets.kt; the colours written here are the picker preview. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/daily_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/w_surface"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/daily_glow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/w_glow"
        android:importantForAccessibility="no"
        android:tint="#2BFCD34D"
        android:scaleType="fitXY" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/daily_eb_icon"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/w_ic_calendar"
                android:importantForAccessibility="no"
                android:tint="#FCD34D" />

            <TextView
                android:id="@+id/daily_eb_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/widget_daily_label"
                android:textColor="#FCD34D"
                android:textSize="10.5sp"
                android:fontFamily="@font/lexend_semibold"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                android:letterSpacing="0.06"
                android:ellipsize="end" />

            <LinearLayout
                android:id="@+id/daily_chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/w_chip"
                android:paddingStart="7dp"
                android:paddingEnd="7dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp">

                <ImageView
                    android:id="@+id/daily_chip_flame"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:src="@drawable/w_flame_fill"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/daily_chip_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#F2FFFFFF"
                    android:textSize="11sp"
                    android:fontFamily="@font/lexend_bold"
                    android:maxLines="1"
                    android:includeFontPadding="false"
                    android:layout_marginStart="3dp" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <FrameLayout
                android:layout_width="60dp"
                android:layout_height="60dp">

                <ImageView
                    android:id="@+id/daily_badge"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/w_badge"
                    android:importantForAccessibility="no"
                    android:tint="#FCD34D" />

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/w_badge_sheen"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/daily_badge_text"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="?"
                    android:textColor="#140F1C"
                    android:textSize="25sp"
                    android:fontFamily="@font/lexend_bold"
                    android:maxLines="1"
                    android:includeFontPadding="false"
                    android:gravity="center"
                    android:paddingStart="3dp"
                    android:paddingEnd="3dp"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="10sp"
                    android:autoSizeMaxTextSize="25sp"
                    android:autoSizeStepGranularity="1sp" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="14dp">

                <TextView
                    android:id="@+id/daily_headline"
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    android:text="Key of B♭"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:fontFamily="@font/lexend_semibold"
                    android:maxLines="1"
                    android:includeFontPadding="false"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="13sp"
                    android:autoSizeMaxTextSize="22sp"
                    android:autoSizeStepGranularity="1sp" />

                <TextView
                    android:id="@+id/daily_score"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:text="9/10"
                    android:textColor="#FFFFFF"
                    android:textSize="30sp"
                    android:fontFamily="@font/lexend_bold"
                    android:maxLines="1"
                    android:includeFontPadding="false"
                    android:visibility="gone"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="16sp"
                    android:autoSizeMaxTextSize="30sp"
                    android:autoSizeStepGranularity="1sp" />

                <TextView
                    android:id="@+id/daily_mode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Chromatic"
                    android:textColor="#FCD34D"
                    android:textSize="12sp"
                    android:fontFamily="@font/lexend_semibold"
                    android:maxLines="1"
                    android:includeFontPadding="false"
                    android:ellipsize="end"
                    android:layout_marginTop="4dp" />

                <ImageView
                    android:id="@+id/daily_bars"
                    android:layout_width="150dp"
                    android:layout_height="5dp"
                    android:src="@drawable/w_dot"
                    android:importantForAccessibility="no"
                    android:visibility="gone"
                    android:layout_marginTop="6dp"
                    android:scaleType="fitXY" />

                <TextView
                    android:id="@+id/daily_sub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_daily_sub_placeholder"
                    android:textColor="#7AFFFFFF"
                    android:textSize="11sp"
                    android:fontFamily="@font/lexend_medium"
                    android:maxLines="1"
                    android:includeFontPadding="false"
                    android:ellipsize="end"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/daily_play"
                android:layout_width="50dp"
                android:layout_height="50dp">

                <ImageView
                    android:id="@+id/daily_glyph_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/w_circle"
                    android:importantForAccessibility="no"
                    android:tint="#FCD34D" />

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/w_circle_shade"
                    android:importantForAccessibility="no" />

                <ImageView
                    android:id="@+id/daily_glyph"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/w_ic_play"
                    android:importantForAccessibility="no"
                    android:tint="#140F1C"
                    android:layout_gravity="center" />
            </FrameLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="0dp" />
    </LinearLayout>
</FrameLayout>
