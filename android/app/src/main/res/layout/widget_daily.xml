<?xml version="1.0" encoding="utf-8"?>
<!-- Design 8 (Daily Challenge 4x2).
     RemoteViews only inflates the classes tagged @RemoteView: no Space,
     no plain View, no ConstraintLayout, no custom drawing. Weighted
     FrameLayouts are the spacers. Colour that varies per key or per mode
     is a setColorFilter on widget_tile_white / widget_square_white,
     because a background drawable cannot be recoloured from here. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/daily_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg_gold"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

    <TextView
        android:id="@+id/daily_label"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:text="@string/widget_daily_label"
        android:textColor="#FCD34D"
        android:textSize="9sp"
        android:letterSpacing="0.18"
        android:maxLines="1"
        android:fontFamily="@font/lexend_semibold" />

        <TextView
            android:id="@+id/daily_streak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_chip_gold"
            android:paddingStart="9dp"
            android:paddingEnd="9dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="@string/widget_daily_streak_placeholder"
            android:textColor="#FCD34D"
            android:textSize="11sp"
            android:maxLines="1"
            android:fontFamily="@font/lexend_semibold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <FrameLayout
            android:layout_width="56dp"
            android:layout_height="56dp">

            <ImageView
                android:id="@+id/daily_key_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/widget_square_white"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/daily_key_letter"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="@string/widget_daily_key_placeholder"
                android:textColor="#FF4D94"
                android:textSize="21sp"
                android:maxLines="1"
                android:fontFamily="@font/outfit_semibold" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="12dp">

            <TextView
                android:id="@+id/daily_headline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/widget_daily_placeholder"
                android:textColor="#FFFFFFFF"
                android:textSize="24sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:fontFamily="@font/outfit_semibold" />

            <TextView
                android:id="@+id/daily_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="7dp"
                android:text="@string/widget_daily_sub_placeholder"
                android:textColor="#80FFFFFF"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:fontFamily="@font/lexend_medium" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp">

            <ImageView
                android:id="@+id/daily_play_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/widget_pill_white"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/daily_play_glyph"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="@string/widget_play_glyph"
                android:textColor="#2A1B04"
                android:textSize="16sp"
                android:fontFamily="@font/lexend_black" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
