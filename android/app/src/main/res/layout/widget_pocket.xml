<?xml version="1.0" encoding="utf-8"?>
<!-- ⑧ Pocket Mode 2×2 — the iOS small Pocket widget.
     RemoteViews inflates only @RemoteView classes: no Space, no plain View,
     no ConstraintLayout. Weighted FrameLayouts are the spacers. Every colour
     that changes at runtime is a setColorFilter on a white drawable, set from
     ImprovyWidgets.kt; the colours written here are the picker preview. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pocket_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/w_surface"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/pocket_glow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/w_glow"
        android:importantForAccessibility="no"
        android:tint="#2B6366F1"
        android:tintMode="src_in"
        android:scaleType="fitXY" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clipChildren="false"
            android:clipToPadding="false">

            <ImageView
                android:id="@+id/pocket_eb_icon"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/w_ic_waveform"
                android:importantForAccessibility="no"
                android:tint="#6366F1" />

            <TextView
                android:id="@+id/pocket_eb_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/widget_pocket_eyebrow"
                android:textColor="#6366F1"
                android:textSize="11.1sp"
                android:fontFamily="@font/outfit_semibold"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                android:letterSpacing="0.1"
                android:ellipsize="end" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="6dp"
            android:clipChildren="false"
            android:clipToPadding="false" />

        <FrameLayout
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_margin="-14dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <ImageView
                android:id="@+id/pocket_glyph_glow"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/w_soft_glow"
                android:importantForAccessibility="no"
                android:tint="#6EFCD34D"
                android:tintMode="src_in"
                android:scaleType="fitXY"
                android:layout_marginTop="4dp" />

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:clipChildren="false"
                android:clipToPadding="false">

                <ImageView
                    android:id="@+id/pocket_glyph_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/w_circle"
                    android:importantForAccessibility="no"
                    android:tint="#6366F1" />

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/w_circle_shade"
                    android:importantForAccessibility="no" />

                <ImageView
                    android:id="@+id/pocket_glyph"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/w_ic_headphones"
                    android:importantForAccessibility="no"
                    android:tint="#FFFFFF"
                    android:layout_gravity="center" />
            </FrameLayout>
        </FrameLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="6dp"
            android:clipChildren="false"
            android:clipToPadding="false" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:text="@string/widget_pocket_label"
            android:textColor="#FFFFFF"
            android:textSize="20.1sp"
            android:fontFamily="@font/outfit_semibold"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="11sp"
            android:autoSizeMaxTextSize="20.1sp"
            android:autoSizeStepGranularity="1sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/widget_pocket_sub"
            android:textColor="#7AFFFFFF"
            android:textSize="11.7sp"
            android:fontFamily="@font/outfit_medium"
            android:maxLines="2"
            android:includeFontPadding="false"
            android:ellipsize="end"
            android:layout_marginTop="2dp" />
    </LinearLayout>
</FrameLayout>
