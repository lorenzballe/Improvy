<?xml version="1.0" encoding="utf-8"?>
<!-- ⑨ Degree of the day 4×2 — the iOS medium theory widget.
     RemoteViews inflates only @RemoteView classes: no Space, no plain View,
     no ConstraintLayout. Weighted FrameLayouts are the spacers. Every colour
     that changes at runtime is a setColorFilter on a white drawable, set from
     ImprovyWidgets.kt; the colours written here are the picker preview. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/theory_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/w_surface"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/theory_glow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/w_glow"
        android:importantForAccessibility="no"
        android:tint="#2BFB7185"
        android:tintMode="src_in"
        android:scaleType="fitXY" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical"
        android:clipChildren="false"
        android:clipToPadding="false">

        <FrameLayout
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <ImageView
                android:id="@+id/theory_circle"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/w_circle"
                android:importantForAccessibility="no"
                android:tint="#24FB7185"
                android:tintMode="src_in" />

            <ImageView
                android:id="@+id/theory_ring"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/w_ring"
                android:importantForAccessibility="no"
                android:tint="#4DFB7185"
                android:tintMode="src_in" />

            <TextView
                android:id="@+id/theory_degree"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="@string/widget_theory_degree_placeholder"
                android:textColor="#FB7185"
                android:textSize="31.8sp"
                android:fontFamily="@font/outfit_semibold"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:gravity="center"
                android:padding="8dp"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="12sp"
                android:autoSizeMaxTextSize="31.8sp"
                android:autoSizeStepGranularity="1sp" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="16dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clipChildren="false"
                android:clipToPadding="false">

                <ImageView
                    android:id="@+id/theory_eb_icon"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/w_ic_book"
                    android:importantForAccessibility="no"
                    android:tint="#FB7185" />

                <TextView
                    android:id="@+id/theory_eb_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_theory_label"
                    android:textColor="#FB7185"
                    android:textSize="11.1sp"
                    android:fontFamily="@font/outfit_semibold"
                    android:maxLines="1"
                    android:includeFontPadding="false"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    android:letterSpacing="0.1"
                    android:ellipsize="end" />
            </LinearLayout>

            <TextView
                android:id="@+id/theory_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/widget_theory_text_placeholder"
                android:textColor="#E6FFFFFF"
                android:textSize="14.3sp"
                android:fontFamily="@font/outfit_medium"
                android:maxLines="4"
                android:includeFontPadding="false"
                android:ellipsize="end"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="1.5dp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
