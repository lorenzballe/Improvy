<?xml version="1.0" encoding="utf-8"?>
<!-- Design 8 (Theory of the day 4x2).
     RemoteViews only inflates the classes tagged @RemoteView: no Space,
     no plain View, no ConstraintLayout, no custom drawing. Weighted
     FrameLayouts are the spacers. Colour that varies per key or per mode
     is a setColorFilter on widget_tile_white / widget_square_white,
     because a background drawable cannot be recoloured from here. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/theory_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="16dp">

    <TextView
        android:id="@+id/theory_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_theory_label"
        android:textColor="#FCD34D"
        android:textSize="9sp"
        android:letterSpacing="0.18"
        android:maxLines="1"
        android:fontFamily="@font/lexend_semibold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="6dp">

        <TextView
            android:id="@+id/theory_degree"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_theory_degree_placeholder"
            android:textColor="#FF4D94"
            android:textSize="46sp"
            android:maxLines="1"
            android:fontFamily="@font/outfit_semibold" />

        <TextView
            android:id="@+id/theory_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="16dp"
            android:paddingEnd="0dp"
            android:text="@string/widget_theory_text_placeholder"
            android:textColor="#B8FFFFFF"
            android:textSize="13sp"
            android:maxLines="4"
            android:ellipsize="end"
            android:fontFamily="@font/lexend_medium" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_theory_hint"
        android:textColor="#66FFFFFF"
        android:textSize="10sp"
        android:maxLines="1"
        android:fontFamily="@font/lexend_medium" />
</LinearLayout>
