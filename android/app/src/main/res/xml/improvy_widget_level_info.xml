<?xml version="1.0" encoding="utf-8"?>
<!-- 2x2. updatePeriodMillis is the floor Android allows (30 min); the app
     also pushes an update whenever it runs, which is what actually keeps these
     fresh. previewLayout draws the real thing in the picker — an unset preview
     shows a grey box, and a grey box in the picker is a widget nobody adds. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="130dp"
    android:minHeight="130dp"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:minResizeWidth="60dp"
    android:minResizeHeight="60dp"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_level"
    android:previewLayout="@layout/widget_level"
    android:previewImage="@mipmap/ic_launcher"
    android:description="@string/widget_level_description"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen" />
