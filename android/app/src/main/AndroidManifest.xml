<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Local reminders (flutter_local_notifications): runtime permission on
         Android 13+, and boot receiver so scheduled reminders survive reboots. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Pocket Mode runs with the screen off: the keep-alive player asks for
         stayAwake, which silently does nothing without this permission — the
         system then dozes the app between questions and the loop stops. -->
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <application
        android:label="Improvy"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- PostHog: disable native auto-init — SDK is configured from Dart -->
        <meta-data android:name="com.posthog.posthog.AUTO_INIT" android:value="false" />
        <!-- flutter_local_notifications: fire scheduled reminders and re-arm
             them after a device reboot. -->
        <receiver android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver" />
        <receiver android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>
        <!-- Home-screen widgets (see ImprovyWidgets.kt). Exported so the
             launcher can host them; they read only what the app publishes
             for them and never write anything back. -->
        <receiver
            android:name=".ImprovyQuizWidgetProvider"
            android:label="@string/widget_quiz_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/improvy_widget_quiz_info" />
        </receiver>
        <receiver
            android:name=".ImprovyQuizWideWidgetProvider"
            android:label="@string/widget_quiz_wide_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/improvy_widget_quiz_wide_info" />
        </receiver>
        <receiver
            android:name=".ImprovyDailyWidgetProvider"
            android:label="@string/widget_daily_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/improvy_widget_daily_info" />
        </receiver>
        <receiver
            android:name=".ImprovyLevelWidgetProvider"
            android:label="@string/widget_level_widget_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/improvy_widget_level_info" />
        </receiver>
        <receiver
            android:name=".ImprovyMapWidgetProvider"
            android:label="@string/widget_map_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/improvy_widget_map_info" />
        </receiver>
        <receiver
            android:name=".ImprovyMapTallWidgetProvider"
            android:label="@string/widget_map_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/improvy_widget_map_tall_info" />
        </receiver>
        <receiver
            android:name=".ImprovyStreakWidgetProvider"
            android:label="@string/widget_streak_widget_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/improvy_widget_streak_info" />
        </receiver>
        <receiver
            android:name=".ImprovyStreakTallWidgetProvider"
            android:label="@string/widget_streak_widget_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/improvy_widget_streak_tall_info" />
        </receiver>
        <receiver
            android:name=".ImprovyWeakestWidgetProvider"
            android:label="@string/widget_weak_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/improvy_widget_weak_info" />
        </receiver>
        <receiver
            android:name=".ImprovyLauncherWidgetProvider"
            android:label="@string/widget_launcher_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/improvy_widget_launcher_info" />
        </receiver>
        <receiver
            android:name=".ImprovyPocketWidgetProvider"
            android:label="@string/widget_pocket_widget_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/improvy_widget_pocket_info" />
        </receiver>
        <receiver
            android:name=".ImprovyTheoryWidgetProvider"
            android:label="@string/widget_theory_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/improvy_widget_theory_info" />
        </receiver>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
