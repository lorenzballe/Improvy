# ---------------------------------------------------------------------------
# Copia questo file in `.env.local` e riempi i valori. `.env.local` è in
# .gitignore: le chiavi non finiscono MAI su GitHub.
# ---------------------------------------------------------------------------

# --- Supabase (login Google + database) ------------------------------------
# Dashboard Supabase -> Project Settings -> Data API / API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Anthropic (Claude) -----------------------------------------------------
# https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=

# --- OpenAI (opzionale: serve solo se attivi un agente su GPT) --------------
OPENAI_API_KEY=

# --- App --------------------------------------------------------------------
# In locale lascia così. In produzione: https://tuodominio.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
